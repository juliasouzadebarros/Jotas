/* =====================================================================
   ARQUIVO: css/style.css
   RESPONSÁVEL: Equipe de CSS / Design
   ---------------------------------------------------------------------
   Estilo de TODAS as páginas do site Jotas, seguindo as telas do design.

   ÍNDICE (procure pelo número):
     1. Variáveis (cores e medidas)  <- mude as cores do site aqui!
     2. Reset e base
     3. Layout geral (menu lateral + conteúdo)
     4. Menu lateral
     5. Cabeçalho (logo, busca, ícones)
     6. Banner
     7. Títulos de seção e grades
     8. Card de produto
     9. Card horizontal (notificações, favoritos, histórico)
    10. Categorias (chips)
    11. Carrinho (itens + resumo)
    12. Favoritos (abas e lojas)
    13. Página de produto
    14. Perfil (formulário e tabela)
    15. Aviso (toast)
    16. Responsivo (celular / tablet) + menu deslizante
    17. Acessibilidade (barra de ajustes, alto contraste, espaçamento)
   ===================================================================== */


/* ---------- 1. VARIÁVEIS ---------- */
:root {
    --verde-menu: #0f4a26;        /* barra lateral */
    --verde-escuro: #0d3b1f;      /* títulos e botões principais */
    --verde: #1f6b35;             /* destaques, selos */
    --verde-medio: #3f8f52;
    --verde-claro: #dcead6;       /* fundo de botões suaves */
    --verde-banner: #e3efdc;      /* fundo do banner */
    --fundo: #f3f6f1;             /* fundo da página */
    --card: #fbfcfa;              /* fundo dos cards */
    --borda: #dfe6da;
    --texto: #15301f;
    --texto-suave: #4f5f54;         /* [A11Y] escurecido para contraste mínimo 4.5:1 */
    --vermelho: #b3261e;
    --raio: 12px;
    --largura-menu: 15.5rem;
}


/* ---------- 2. RESET E BASE ---------- */
* { box-sizing: border-box; margin: 0; padding: 0; }

body {
    font-family: "Poppins", "Segoe UI", Arial, sans-serif;
    background: var(--fundo);
    color: var(--texto);
    line-height: 1.4;
}

a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }
button { font-family: inherit; cursor: pointer; }
ul { list-style: none; }
[hidden] { display: none !important; }   /* garante que o atributo hidden funcione */

svg { width: 1.25em; height: 1.25em; flex-shrink: 0; }

/* [A11Y] Texto só para leitor de tela: invisível, mas continua "lido" */
.so-leitor {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
}

/* [A11Y] Link "pular para o conteúdo": escondido até receber foco (tecla Tab) */
.pular-link {
    position: absolute;
    left: 12px; top: -80px;
    z-index: 100;
    background: #fff; color: var(--verde-escuro);
    border: 3px solid var(--verde-escuro);
    padding: 10px 18px;
    border-radius: 10px;
    font-weight: 600;
}
.pular-link:focus { top: 12px; }

/* Foco visível para quem navega pelo teclado */
a:focus-visible, button:focus-visible, input:focus-visible {
    outline: 3px solid var(--verde-medio);
    outline-offset: 2px;
}


/* ---------- 3. LAYOUT GERAL ----------
   <body>
     <aside id="menu-lateral">   (fixo na esquerda)
     <main class="conteudo">     (empurrado para a direita pela margem)   */
.conteudo {
    margin-left: var(--largura-menu);
    padding: 20px 28px 48px;
    max-width: calc(var(--largura-menu) + 1280px);
}

/* ---------- RODAPÉ COMPARTILHADO ---------- */
.rodape-site {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
    padding: 24px 0 0;
    border-top: 1px solid var(--borda);
    color: var(--texto-suave);
    font-size: .9rem;
}
.rodape-marca > a { color: var(--verde-escuro); font-size: 1.2rem; font-weight: 700; }
.rodape-marca p { margin-top: 6px; }
.rodape-coluna { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
.rodape-coluna h2 { color: var(--texto); font-size: .95rem; margin-bottom: 2px; }
.rodape-site a:hover { color: var(--verde); text-decoration: underline; }
.rodape-copyright { grid-column: 1 / -1; padding-top: 14px; border-top: 1px solid var(--borda); font-size: .8rem; }


/* ---------- 4. MENU LATERAL ---------- */
/* [A11Y] no menu escuro o contorno de foco precisa ser branco */
#menu-lateral :focus-visible { outline-color: #fff; }

#menu-lateral {
    position: fixed;
    top: 0; left: 0; bottom: 0;
    width: var(--largura-menu);
    background: var(--verde-menu);
    color: #fff;
    padding: 24px 12px;
    overflow-y: auto;
}

.menu-usuario {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 8px 28px;
}
.avatar {
    width: 48px; height: 48px;
    border-radius: 50%;
    background: var(--verde-medio);
    display: grid; place-items: center;
    font-size: 1.5rem;
}
.menu-usuario-texto strong { display: block; font-size: 1rem; font-weight: 500; }
.menu-usuario-texto small {
    display: flex; align-items: center; gap: 2px;
    font-size: 0.75rem;
}
.menu-usuario-texto small svg { width: 12px; height: 12px; }

.menu-lista { display: grid; gap: 4px; }
.menu-link {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 14px;
    border-radius: 10px;
    font-size: 0.9375rem;
    transition: background .2s;
}
.menu-link svg { width: 26px; height: 26px; }
.menu-link:hover { background: rgba(255, 255, 255, .08); }
.menu-link.ativo { background: #2b6c3c; }   /* página atual */

/* Bolinha com número (carrinho / notificações) */
.badge {
    background: var(--verde);   /* [A11Y] verde mais escuro = texto branco legível */
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    min-width: 22px; height: 22px;
    border-radius: 11px;
    display: inline-grid; place-items: center;
    padding: 0 6px;
}
.menu-link .badge { margin-left: auto; }


/* ---------- 5. CABEÇALHO ---------- */
.cabecalho-topo {
    display: grid;
    grid-template-columns: 1fr auto 1fr;   /* esquerda vazia | logo | ícones */
    align-items: center;
}
.logo img { height: 64px; width: auto; mix-blend-mode: multiply; }  /* multiply some com o fundo branco do logo */
.cabecalho-acoes { display: flex; justify-content: flex-end; gap: 24px; }

.icone-topo {
    position: relative;
    color: var(--verde-escuro);
    font-size: 1.875rem;
    display: grid;
}
.icone-topo svg { width: 34px; height: 34px; }
.icone-topo .badge {
    position: absolute;
    top: -8px; right: -10px;
    background: var(--verde-escuro);
    font-size: 0.6875rem; min-width: 20px; height: 20px;
}

/* Barra de busca */
.busca {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 860px;
    margin: 10px auto 20px;
    border: 2px solid var(--verde-escuro);
    border-radius: 999px;
    background: #fff;
    padding: 4px 4px 4px 16px;
}
.busca > svg { color: var(--verde-escuro); }
.busca input {
    flex: 1;
    border: 0; outline: 0;
    background: transparent;
    font: inherit; font-size: 0.875rem;
    padding: 8px 0;
}
.busca button {
    background: var(--verde-escuro);
    color: #fff;
    border: 0;
    width: 64px; height: 38px;
    flex-shrink: 0;                 /* não deixa o botão espremer no celular */
    border-radius: 999px;
    display: grid; place-items: center;
}
.busca button:hover { background: var(--verde); }


/* ---------- 6. BANNER ---------- */
.banner {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: linear-gradient(100deg, var(--verde-banner) 55%, #cfe3c6);
    border-radius: var(--raio);
    padding: 28px 36px;
    min-height: 160px;
    margin-bottom: 28px;
}
/* Curva decorativa do lado direito */
.banner::after {
    content: "";
    position: absolute;
    right: -80px; bottom: -120px;
    width: 340px; height: 300px;
    border-radius: 50%;
    background: #a9cf9a;
    opacity: .55;
}
.banner-texto, .banner-icone { position: relative; z-index: 1; }
.banner h1 { font-size: 1.875rem; line-height: 1.15; color: var(--verde-escuro); margin-bottom: 8px; }
.banner p { color: #2c4a36; max-width: 46ch; }
.banner-icone { color: var(--verde-escuro); margin-right: 40px; }
.banner-icone svg { width: 110px; height: 110px; stroke-width: 1.6; }

/* Banner da Home é uma imagem */
.banner-imagem { border-radius: var(--raio); margin-bottom: 28px; overflow: hidden; background: #e6f1df; }
/* contain = a imagem inteira aparece, sem cortar o texto do banner */
.banner-imagem img { width: 100%; height: 300px; object-fit: contain; }


/* ---------- 7. TÍTULOS E GRADES ---------- */
.secao-titulo { font-size: 1.5rem; color: var(--verde-escuro); margin: 8px 0 14px; }
.secao-sub { color: var(--texto-suave); font-size: 0.875rem; margin: -10px 0 14px; }
.secao + .secao { margin-top: 32px; }

/* Grade de cards: quantas colunas couberem (mínimo 200px cada) */
.grade-produtos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 16px;
}
.vazio {
    grid-column: 1 / -1;
    color: var(--texto-suave);
    padding: 24px 0;
}
.vazio a { color: var(--verde); text-decoration: underline; }


/* ---------- 8. CARD DE PRODUTO ---------- */
.card-produto {
    background: var(--card);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    overflow: hidden;
    display: flex;
    flex-direction: column;
}
.card-imagem {
    position: relative;
    background: #fff;
    height: 190px;
    padding: 12px;
}
/* A foto ocupa a caixa toda sem estourar (object-fit: contain mantém a proporção) */
.card-imagem img { width: 100%; height: 100%; object-fit: contain; }
.card-imagem a { display: block; height: 100%; }

.selo-desconto {
    position: absolute; top: 10px; left: 10px;
    background: var(--verde); color: #fff;
    font-size: 0.75rem; font-weight: 600;
    padding: 3px 10px; border-radius: 999px;
}
.selo-mini {
    background: var(--verde); color: #fff;
    font-size: 0.6875rem; font-weight: 600;
    padding: 1px 7px; border-radius: 999px;
    text-decoration: none; display: inline-block;
}

/* Coração de favoritar */
.btn-favorito {
    position: absolute; top: 10px; right: 10px;
    width: 32px; height: 32px;
    border-radius: 50%;
    border: 1px solid var(--borda);
    background: #fff;
    color: var(--verde-escuro);
    display: grid; place-items: center;
}
.btn-favorito svg { width: 17px; height: 17px; }
.btn-favorito.ativo { color: var(--verde); }
.btn-favorito.ativo svg { fill: currentColor; }   /* coração preenchido */

.card-corpo { padding: 12px 14px 14px; display: flex; flex-direction: column; flex: 1; }
.card-nome { font-size: 0.8438rem; font-weight: 500; min-height: 38px; }
.card-nome:hover { text-decoration: underline; }
.card-nota { font-size: 0.7812rem; color: var(--texto-suave); margin: 6px 0; }
.estrela { color: var(--verde-escuro); }
.card-avaliacoes { color: var(--texto-suave); font-size: 0.7812rem; }
.preco-antigo { font-size: 0.7812rem; color: var(--texto-suave); text-decoration: line-through; }
.selo-mini { text-decoration: none; }
.preco { font-size: 1.125rem; font-weight: 700; color: var(--verde-escuro); }
.parcelas { font-size: 0.75rem; color: var(--texto-suave); }
.economia { font-size: 0.75rem; color: var(--verde); font-weight: 500; }

.card-rodape {
    margin-top: auto;
    padding-top: 8px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 8px;
}
.btn-carrinho {
    width: 38px; height: 38px;
    border-radius: 10px;
    border: 0;
    background: var(--verde-claro);
    color: var(--verde);
    display: grid; place-items: center;
    transition: background .2s, color .2s;
}
.btn-carrinho:hover { background: var(--verde); color: #fff; }


/* ---------- 9. CARD HORIZONTAL ---------- */
.lista-horizontal { display: grid; gap: 14px; }
.lista-horizontal.duas-colunas { grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); }

.card-horizontal {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
    background: var(--card);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 14px;
}
.card-horizontal > img {
    width: 120px; height: 120px;
    object-fit: contain;
    background: #fff;
    border-radius: 10px;
    padding: 6px;
}
.card-horizontal-info { flex: 1; }
.card-horizontal-info h3 { font-size: 1rem; margin-bottom: 2px; }
.card-horizontal-info h3 a:hover { text-decoration: underline; }
.notificacao-texto { font-size: 0.8125rem; color: var(--verde); font-weight: 500; margin-bottom: 4px; }
.card-horizontal .btn-favorito { top: 12px; right: 12px; }

.btn-secundario {
    border: 2px solid var(--verde-escuro);
    color: var(--verde-escuro);
    border-radius: 999px;
    padding: 8px 18px;
    font-size: 0.875rem; font-weight: 500;
    white-space: nowrap;
}
.btn-secundario:hover { background: var(--verde-escuro); color: #fff; }


/* ---------- 10. CATEGORIAS (chips) ---------- */
.chips { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 22px; }
.chip {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 22px;
    border-radius: 999px;
    border: 1px solid var(--borda);
    background: var(--card);
    color: var(--texto);
    font-size: 0.875rem;
}
.chip svg { width: 22px; height: 22px; }
.chip:hover { border-color: var(--verde); }
.chip.ativo { background: var(--verde-escuro); color: #fff; border-color: var(--verde-escuro); }


/* ---------- 11. CARRINHO ---------- */
/* Duas colunas: itens (esquerda) + resumo (direita) */
.carrinho-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 24px;
    align-items: start;
}
.carrinho-topo { display: flex; justify-content: space-between; align-items: center; margin: 8px 0 14px; }
.carrinho-topo .secao-titulo { margin: 0; }
.carrinho-topo span.contagem { font-weight: 400; color: var(--texto-suave); }
.btn-texto {
    display: flex; align-items: center; gap: 6px;
    background: none; border: 0;
    color: var(--texto); font-size: 0.875rem;
}
.btn-texto:hover { color: var(--vermelho); }

.card-carrinho .card-imagem { height: 150px; }
.check-item {
    position: absolute; top: 12px; left: 12px;
    width: 22px; height: 22px;
    accent-color: var(--verde);
    cursor: pointer;
}
.quantidade {
    display: flex; align-items: center;
    border: 1px solid var(--borda);
    border-radius: 8px;
    background: #fff;
}
.quantidade button {
    width: 30px; height: 30px;
    border: 0; background: none;
    font-size: 1.125rem; color: var(--verde-escuro);
}
.quantidade span { min-width: 26px; text-align: center; font-size: 0.875rem; }
.btn-lixeira { border: 0; background: none; color: var(--texto-suave); font-size: 1.25rem; }
.btn-lixeira:hover { color: var(--vermelho); }

/* Resumo da compra */
.resumo {
    background: var(--verde-banner);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 20px;
    position: sticky; top: 16px;
}
.resumo h2 { font-size: 1.25rem; color: var(--verde-escuro); margin-bottom: 10px; }
.resumo h3 { font-size: 0.9375rem; margin-bottom: 10px; }
.resumo-itens { background: #fff; border-radius: 10px; padding: 8px 12px; margin-bottom: 14px; }
.resumo-itens li { display: flex; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--borda); font-size: 0.8125rem; }
.resumo-itens li:last-child { border-bottom: 0; }
.resumo-itens img { width: 48px; height: 48px; object-fit: contain; }
.resumo-itens strong { display: block; font-weight: 500; }
.resumo-itens .preco { font-size: 0.9375rem; display: block; }
.resumo-itens small { color: var(--texto-suave); }

.resumo-linha { display: flex; justify-content: space-between; font-size: 0.875rem; padding: 4px 0; }
.resumo-total {
    display: flex; justify-content: space-between;
    font-size: 1.25rem; font-weight: 700;
    color: var(--verde-escuro);
    border-top: 1px solid #b9cdb1;
    margin-top: 10px; padding-top: 12px;
}
.resumo-economia {
    display: flex; align-items: center; gap: 10px;
    background: var(--verde-claro);
    border-radius: 10px;
    padding: 10px 14px; margin: 14px 0;
    font-size: 0.8125rem;
}
.resumo-economia svg { width: 24px; height: 24px; color: var(--verde); }
.resumo-economia strong { display: block; font-size: 0.9375rem; }

.btn-principal {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    width: 100%;
    background: var(--verde-escuro);
    color: #fff;
    border: 0;
    border-radius: 10px;
    padding: 14px 20px;
    font-size: 0.9375rem; font-weight: 500;
}
.btn-principal:hover { background: var(--verde); }
.btn-principal:disabled { background: #9db5a5; cursor: not-allowed; }
.link-continuar { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 14px; font-size: 0.875rem; }
.link-continuar:hover { text-decoration: underline; }


/* ---------- 12. FAVORITOS ---------- */
.abas {
    display: inline-flex;
    border: 1px solid var(--borda);
    border-radius: 999px;
    background: var(--card);
    margin-bottom: 22px;
}
.aba {
    display: flex; align-items: center; gap: 10px;
    border: 0; background: none;
    padding: 10px 44px;
    border-radius: 999px;
    font-size: 0.9375rem; color: var(--texto);
}
.aba.ativo { background: var(--verde-escuro); color: #fff; }

.card-loja {
    display: flex; gap: 16px;
    background: var(--card);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 16px;
}
.loja-logo {
    width: 84px; height: 84px; flex-shrink: 0;
    border-radius: 50%;
    background: var(--verde-menu); color: #fff;
    display: grid; place-items: center;
    font-size: 2.125rem; font-weight: 600;
}
.loja-info h3 { font-size: 1rem; }
.loja-selo {
    display: inline-block;
    background: var(--verde-claro); color: var(--verde);
    font-size: 0.6875rem; padding: 1px 8px; border-radius: 6px; margin: 2px 0;
}
.loja-vantagens { font-size: 0.7812rem; color: var(--texto-suave); display: grid; gap: 4px; margin-top: 6px; }
.loja-vantagens li { display: flex; align-items: center; gap: 8px; }
.loja-vantagens svg { width: 15px; height: 15px; color: var(--verde); }


/* ---------- 13. PÁGINA DE PRODUTO ---------- */
.produto-topo {
    display: grid;
    grid-template-columns: minmax(260px, 460px) 1fr;
    gap: 36px;
    background: var(--card);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 28px;
    margin-bottom: 24px;
}
.produto-foto { background: #fff; border-radius: var(--raio); padding: 20px; display: grid; place-items: center; }
.produto-foto img { max-height: 380px; object-fit: contain; }
.produto-categoria { color: var(--verde); font-size: 0.8125rem; font-weight: 500; }
.produto-info h1 { font-size: 1.75rem; color: var(--verde-escuro); margin: 4px 0; }
.preco-grande { font-size: 2.125rem; margin-top: 4px; }
.produto-botoes { display: flex; flex-wrap: wrap; gap: 12px; margin: 22px 0 16px; max-width: 480px; }
.produto-botoes .btn-principal { flex: 1 1 240px; width: auto; }
.btn-favorito-texto {
    position: static;
    width: auto; height: auto;
    border-radius: 10px;
    border: 2px solid var(--verde-escuro);
    padding: 12px 20px;
    display: flex; align-items: center; gap: 8px;
    font-size: 0.9375rem; font-weight: 500;
}
.btn-favorito-texto svg { width: 20px; height: 20px; }
.link-voltar { display: inline-flex; align-items: center; gap: 4px; color: var(--verde); font-size: 0.875rem; }
.link-voltar:hover { text-decoration: underline; }

.detalhes {
    background: var(--card);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 24px 28px;
}
.detalhes h2 { color: var(--verde-escuro); margin-bottom: 14px; font-size: 1.375rem; }
.detalhes li {
    padding: 12px 0 12px 22px;
    border-bottom: 1px solid var(--borda);
    position: relative;
    max-width: 90ch;
}
.detalhes li:last-child { border-bottom: 0; }
.detalhes li::before {
    content: "";
    position: absolute; left: 0; top: 20px;
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--verde-medio);
}
.detalhes strong { color: var(--verde-escuro); }


/* ---------- 14. PERFIL ---------- */
.formulario {
    background: var(--card);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 24px 28px;
    margin-bottom: 24px;
}
.formulario legend { font-size: 1.25rem; font-weight: 600; color: var(--verde-escuro); padding: 0 8px; }
.campos { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin: 12px 0 20px; }
.campo label { display: block; font-size: 0.8125rem; color: var(--texto-suave); margin-bottom: 4px; }
.campo input {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--borda);
    border-radius: 10px;
    background: #fff;
    font: inherit; font-size: 0.875rem;
}
.campo input:focus { border-color: var(--verde); }
.formulario .btn-principal { width: auto; }

.tabela-rolagem { overflow-x: auto; }   /* a tabela rola de lado no celular */
table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
th { background: var(--verde-banner); color: var(--verde-escuro); text-align: left; padding: 10px 14px; }
td { padding: 10px 14px; border-bottom: 1px solid var(--borda); }
.status-entregue { color: var(--verde); font-weight: 600; }


/* ---------- 15. AVISO (toast) ----------
   [A11Y] O aviso sempre mostra TEXTO + ÍCONE + COR juntos (nunca só uma cor),
   para servir a quem não enxerga bem cores. As classes tipo-sucesso/tipo-remover
   mudam a cor; a classe "reforcado" (ligada no painel de acessibilidade) aumenta
   o aviso e faz a borda piscar — útil para quem não conta com um som de alerta. */
.aviso {
    position: fixed;
    bottom: 24px; left: 50%;
    transform: translate(-50%, 30px);
    display: flex; align-items: center; gap: 10px;
    background: var(--verde-escuro);
    color: #fff;
    border: 3px solid transparent;
    padding: 12px 24px;
    border-radius: 999px;
    font-size: 0.875rem;
    max-width: min(90vw, 420px);
    opacity: 0;
    pointer-events: none;
    transition: opacity .25s, transform .25s;
    z-index: 70;
}
.aviso-icone { display: flex; flex-shrink: 0; }
.aviso-icone svg { width: 20px; height: 20px; }
.aviso.visivel { opacity: 1; transform: translate(-50%, 0); }
.aviso.tipo-remover { background: #5c2420; }
.aviso.reforcado {
    font-size: 1rem;
    padding: 16px 28px;
    border-color: #ffd400;
    animation: piscar-borda 1s ease-in-out 3;
}
@keyframes piscar-borda {
    0%, 100% { border-color: #ffd400; }
    50% { border-color: transparent; }
}
@media (prefers-reduced-motion: reduce) {
    .aviso.reforcado { animation: none; }
}


/* ---------- 16. RESPONSIVO ----------
   Três "degraus" de tela:
     até 1100px = tablet grande (resumo do carrinho vai para baixo)
     até 900px  = tablet/celular (menu vira gaveta deslizante)
     até 600px  = celular (2 colunas de produtos, textos menores)      */

/* Botão do menu: no computador fica invisível (mas ocupa o lugar,
   para o logo continuar centralizado) */
.btn-menu {
    visibility: hidden;
    justify-self: start;
    width: 44px; height: 44px;
    border: 2px solid var(--verde-escuro);
    border-radius: 10px;
    background: #fff;
    color: var(--verde-escuro);
    display: grid; place-items: center;
}
.btn-menu svg { width: 26px; height: 26px; }
.menu-fechar { display: none; }
.menu-fundo { display: none; }

@media (max-width: 1100px) {
    .carrinho-layout { grid-template-columns: 1fr; }
    .resumo { position: static; }
}

@media (max-width: 900px) {
    .conteudo { margin-left: 0; padding: 14px 16px 90px; }
    .rodape-site { grid-template-columns: 1fr 1fr; }
    .rodape-marca { grid-column: 1 / -1; }
    .btn-menu { visibility: visible; }

    /* Menu lateral vira gaveta: fica fora da tela até abrir */
    #menu-lateral {
        width: min(20rem, 85vw);
        z-index: 60;
        transform: translateX(-100%);
        visibility: hidden;                       /* fora do Tab quando fechado */
        transition: transform .25s, visibility 0s .25s;
    }
    body.menu-aberto #menu-lateral {
        transform: translateX(0);
        visibility: visible;
        transition: transform .25s;
    }
    .menu-fechar {
        display: grid; place-items: center;
        margin: 0 0 8px auto;
        width: 44px; height: 44px;
        border: 0; border-radius: 10px;
        background: rgba(255, 255, 255, .12);
        color: #fff;
    }
    .menu-fundo {
        display: block;
        position: fixed; inset: 0;
        background: rgba(0, 0, 0, .55);
        opacity: 0; pointer-events: none;
        transition: opacity .25s;
        z-index: 55;
    }
    body.menu-aberto .menu-fundo { opacity: 1; pointer-events: auto; }
    body.menu-aberto { overflow: hidden; }        /* trava a rolagem do fundo */

    .menu-link { padding: 14px; }                 /* área de toque confortável */
    .logo img { height: 52px; }
    .icone-topo svg { width: 30px; height: 30px; }
    .cabecalho-acoes { gap: 18px; }
    .produto-topo { grid-template-columns: 1fr; padding: 18px; gap: 20px; }
    .banner-icone { margin-right: 10px; }
    .banner-icone svg { width: 84px; height: 84px; }
}

@media (max-width: 600px) {
    .rodape-site { grid-template-columns: 1fr 1fr; }
    .rodape-marca { grid-column: 1 / -1; }
    .banner { padding: 18px; min-height: 0; }
    .banner h1 { font-size: 1.3rem; }
    .banner-icone { display: none; }
    .banner-imagem img { height: 150px; }
    .secao-titulo { font-size: 1.25rem; }

    /* 2 colunas de produtos, cards mais compactos */
    .grade-produtos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .card-imagem { height: 140px; padding: 8px; }
    .card-corpo { padding: 10px; }
    .card-nome { font-size: .8rem; min-height: 0; }
    .preco { font-size: 1rem; }
    .btn-carrinho { width: 44px; height: 44px; }
    .btn-favorito { width: 40px; height: 40px; }
    .card-carrinho .card-imagem { height: 120px; }
    .quantidade button { width: 36px; height: 36px; }
    .btn-lixeira { width: 40px; height: 40px; }

    .busca button { width: 48px; height: 40px; }
    .barra-lista { flex-direction: column; align-items: flex-start; }
    .lista-horizontal.duas-colunas { grid-template-columns: 1fr; }
    .card-horizontal { flex-wrap: wrap; padding: 12px; }
    .card-horizontal > img { width: 80px; height: 80px; }
    .card-horizontal .btn-secundario { width: 100%; text-align: center; padding: 12px; }
    .card-loja { flex-direction: column; align-items: flex-start; }

    .chip { padding: 10px 16px; font-size: .85rem; }
    .aba { padding: 12px 22px; }
    .abas { display: flex; }
    .aba { flex: 1; justify-content: center; }
    .produto-botoes .btn-principal, .btn-favorito-texto { flex: 1 1 100%; justify-content: center; }
    .produto-info h1 { font-size: 1.4rem; }
    .preco-grande { font-size: 1.7rem; }
    .detalhes { padding: 16px; }
    .formulario { padding: 16px; }
    .aviso { bottom: 84px; width: max-content; max-width: 90vw; text-align: center; }
    .a11y-abrir span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .a11y-abrir { padding: 12px; }
}

/* Respeita quem desativou animações no sistema */
@media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
}

/* Ajustes para celulares estreitos e para evitar rolagem horizontal. */
@media (max-width: 600px) {
    html, body { max-width: 100%; overflow-x: clip; }
    .conteudo { width: 100%; min-width: 0; }
    .cabecalho-topo { grid-template-columns: 44px minmax(0, 1fr) auto; gap: 8px; }
    .logo { min-width: 0; justify-self: center; }
    .logo img { max-width: 100%; object-fit: contain; }
    .cabecalho-acoes { gap: 12px; }
    .busca { min-width: 0; }
    .busca input { min-width: 0; }
    .grade-produtos, .carrinho-layout, .produto-topo, .lista-horizontal,
    .card-horizontal-info, .produto-info { min-width: 0; }
    .card-nome, .card-horizontal-info h3, .produto-info h1 { overflow-wrap: anywhere; }
    .card-rodape { align-items: center; }
    .resumo { min-width: 0; }
}

@media (max-width: 360px) {
    .conteudo { padding-right: 12px; padding-left: 12px; }
    .rodape-site { grid-template-columns: 1fr; gap: 16px; }
    .rodape-marca, .rodape-copyright { grid-column: auto; }
    .cabecalho-topo { grid-template-columns: 40px minmax(0, 1fr) auto; gap: 6px; }
    .btn-menu { width: 40px; height: 40px; }
    .logo img { height: 44px; }
    .cabecalho-acoes { gap: 8px; }
    .icone-topo svg { width: 26px; height: 26px; }
    .grade-produtos { gap: 8px; }
    .card-imagem { height: 120px; }
    .card-corpo { padding: 8px; }
    .preco { font-size: .95rem; }
}


/* ---------- 17. ACESSIBILIDADE ---------- */

/* Barra "Ordenar por" e contagem de resultados */
.barra-lista { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
.contagem { font-size: .9rem; color: var(--texto-suave); }
.ordenar { display: flex; align-items: center; gap: 8px; font-size: .9rem; }
.ordenar select {
    font: inherit;
    min-height: 44px;
    padding: 6px 12px;
    border: 2px solid var(--verde-escuro);
    border-radius: 10px;
    background: #fff;
    color: var(--texto);
}
.quantidade button:disabled { opacity: .35; cursor: not-allowed; }

/* Botão flutuante + painel de ajustes */
.a11y { position: fixed; right: 16px; bottom: 16px; z-index: 40; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
.a11y-abrir {
    display: flex; align-items: center; gap: 8px;
    background: var(--verde-escuro); color: #fff;
    border: 2px solid #fff;
    border-radius: 999px;
    padding: 12px 18px;
    font-size: .9rem; font-weight: 500;
    box-shadow: 0 4px 14px rgba(0, 0, 0, .3);
}
.a11y-abrir svg { width: 24px; height: 24px; }
.a11y-painel {
    background: #fff;
    border: 2px solid var(--verde-escuro);
    border-radius: var(--raio);
    padding: 16px;
    width: min(18rem, calc(100vw - 32px));
    box-shadow: 0 6px 20px rgba(0, 0, 0, .25);
    display: grid; gap: 10px;
}
.a11y-painel[hidden] { display: none; }
.a11y-titulo { font-weight: 600; color: var(--verde-escuro); font-size: .9rem; margin-top: 4px; }
.a11y-titulo:first-child { margin-top: 0; }
.a11y-nota { font-size: .78rem; color: var(--texto-suave); margin-top: -4px; }
.a11y-opcao { display: flex; align-items: center; gap: 8px; }
.a11y-opcao svg { width: 18px; height: 18px; }
.a11y-linha { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.a11y-painel button {
    min-height: 44px;
    border: 2px solid var(--verde-escuro);
    border-radius: 10px;
    background: #fff;
    color: var(--verde-escuro);
    font-size: .95rem; font-weight: 600;
    padding: 8px 12px;
}
.a11y-painel button:hover:not(:disabled) { background: var(--verde-claro); }
.a11y-painel button[aria-pressed="true"] { background: var(--verde-escuro); color: #fff; }
.a11y-painel button:disabled { opacity: .4; cursor: not-allowed; }

/* MAIS ESPAÇO entre letras, palavras e linhas (ajuda quem tem dislexia/baixa visão) */
html.espacamento body { letter-spacing: .12em; word-spacing: .16em; line-height: 1.8; }
html.espacamento p { margin-bottom: .5em; }

/* ALTO CONTRASTE: só troca as variáveis de cor + bordas mais fortes */
html.alto-contraste {
    --fundo: #ffffff;
    --card: #ffffff;
    --borda: #000000;
    --texto: #000000;
    --texto-suave: #1a1a1a;
    --verde: #004d1a;
    --verde-escuro: #002e0f;
    --verde-medio: #004d1a;
    --verde-menu: #000000;
    --verde-claro: #ffffff;
    --verde-banner: #ffffff;
}
html.alto-contraste .banner { border: 2px solid #000; background: #fff; }
html.alto-contraste .banner::after { display: none; }
html.alto-contraste .card-produto,
html.alto-contraste .card-horizontal,
html.alto-contraste .card-loja,
html.alto-contraste .resumo,
html.alto-contraste .detalhes,
html.alto-contraste .produto-topo,
html.alto-contraste .formulario { border: 2px solid #000; }
html.alto-contraste .btn-carrinho,
html.alto-contraste .resumo-economia { border: 2px solid #000; }
html.alto-contraste .menu-link.ativo { background: #fff; color: #000; }
html.alto-contraste .menu-link:hover { background: #333; }
html.alto-contraste .menu-usuario-texto small { opacity: 1; }
html.alto-contraste .avatar, html.alto-contraste .badge { background: #fff; color: #000; }
html.alto-contraste a:not(.menu-link):not(.logo):not(.card-imagem a):not(.pular-link) { text-decoration: underline; }
html.alto-contraste :focus-visible { outline: 4px solid #ff8c00; outline-offset: 3px; }
html.alto-contraste #menu-lateral :focus-visible { outline-color: #ffd400; }
